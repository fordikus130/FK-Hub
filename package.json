{
  "name": "fk-hub",
  "version": "1.0.0",
  "description": "FK Hub by fordik130",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.fordik130.fkhub",
    "productName": "FK Hub",
    "compression": "store",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "FK Hub.exe",
      "requestExecutionLevel": "admin",
      "unpackDirName": "FK_Hub"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}